# Environment for Playwright E2E tests (php artisan ... --env=e2e).
# Copy to .env.e2e and fill in the Midtrans sandbox keys. Never commit .env.e2e.
# APP_ENV must stay "e2e": `php artisan serve` passes it to the PHP server so
# that process loads this file too.
APP_NAME=Infaqin
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# scripts/e2e-reset.mjs deletes this file and refuses any other path.
DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans sandbox keys (dashboard.sandbox.midtrans.com > Settings > Access Keys).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
